# Images/video that ship live in static/ ONLY. Every other image/video file
# (debug screenshots, Playwright captures, scratch PNGs) is ignored so it never
# gets committed. Put scratch screenshots in test-screenshots/ or /tmp — NEVER
# the project root.
*.mov
*.mp4
*.png
*.jpg
*.jpeg
*.webp
*.gif
!static/**
docs/feature/.manifest.json.bak
docs/feature/.manifest.json.tmp.*

# Vite build output belongs in dist/ — a hashed bundle at the repo root means a
# build was run with the wrong outDir (two ~2.5MB index-*.js chunks were found
# untracked here). Ignore hashed chunks/maps at root only; eslint.config.js and
# any other real root-level JS are unaffected because they carry no hash suffix.
/index-*.js
/index-*.js.map
/index-*.css
/assets/

# Cached native better-sqlite3 binaries per ABI (Node vs Electron). Local dev
# aid for swapping without a full rebuild — never commit the .node blobs.
.native-cache/
