<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. allowBackup is false; this excludes everything in case it is ever
     turned on: the vault's ciphertext, Preferences and WebView data never leave the phone. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
